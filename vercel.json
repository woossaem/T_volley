{
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/live/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(kakaotalk-scrap|facebookexternalhit|twitterbot|slackbot|discordbot|whatsapp|telegrambot|kakaostory|linkedinbot|embedly).*"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "noscrape"
        }
      ],
      "destination": "/api/og-live?id=:id"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}