{
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/live/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(kakaotalk|Kakaotalk|KAKAOTALK|facebookexternalhit|twitterbot|slackbot).*"
        }
      ],
      "destination": "/api/og?id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
