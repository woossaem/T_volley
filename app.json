{
  "expo": {
    "name": "티볼리",
    "slug": "t-volley",
    "scheme": "t-volley",
    "version": "2.3.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진 등록 및 변경을 위해 사진앨범 접근 권한이 필요합니다.",
          "cameraPermission": "프로필 사진 직접 촬영 및 등록을 위해 카메라 접근 권한이 필요합니다."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "이어폰 버튼으로 음성 득점 기록을 하기 위해 마이크가 필요합니다.",
          "speechRecognitionPermission": "이어폰 음성 명령을 한글로 알아듣기 위해 음성 인식이 필요합니다.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      "expo-apple-authentication",
      "./plugins/withStripIosBackgroundModes.js"
    ],
    "android": {
      "package": "com.rudolfuu.tvolley",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "RECORD_AUDIO",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.rudolfuu.tvolley",
      "buildNumber": "5",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "프로필 사진 등록 및 변경을 위해 사진앨범 접근 권한이 필요합니다.",
        "NSCameraUsageDescription": "프로필 사진 직접 촬영 및 등록을 위해 카메라 접근 권한이 필요합니다.",
        "NSMicrophoneUsageDescription": "이어폰 버튼으로 음성 득점 기록을 하기 위해 마이크가 필요합니다.",
        "NSSpeechRecognitionUsageDescription": "이어폰 음성 명령을 한글로 알아듣기 위해 음성 인식이 필요합니다."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "meta": {
        "og:title": "🏐 티볼리 실시간 라이브 전광판",
        "og:description": "✅ 로그인 없이 클릭 한 번으로! 오늘의 실시간 점수, 세부 스탯, 문자 중계를 바로 확인해 보세요.",
        "og:image": "/og-logo.png"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "05ba1249-84cc-45cb-809f-9e7a722a4a76"
      }
    },
    "runtimeVersion": "2.0.0",
    "updates": {
      "url": "https://u.expo.dev/05ba1249-84cc-45cb-809f-9e7a722a4a76"
    }
  }
}
